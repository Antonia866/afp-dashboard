<script>
	document.addEventListener('DOMContentLoaded', function () {
		const params = new URLSearchParams(window.location.search);
	});

	function abrirModalCMF() {
		cmfModalActivo = true;
		document.getElementById('cmf-modal-mensaje').classList.add('activo');
		document.getElementById('cmf-overlay').classList.add('activo');
		document.body.style.overflow = 'hidden';
	}

	function cerrarModalCMF() {
		cmfModalActivo = false;
		document.getElementById('cmf-modal-mensaje').classList.remove('activo');
		document.getElementById('cmf-overlay').classList.remove('activo');
		document.body.style.overflow = '';
	}
</script>

<style>
	.cmf-ventana-modal-base {
		position: fixed;
		inset: 0;
		background: rgba(60, 70, 120, 0.15);
		display: none;
		align-items: center;
		justify-content: center;
		z-index: 9999;
		font-family: 'Segoe UI', system-ui, sans-serif;
	}

	.cmf-ventana-modal-base.activo {
		display: flex;
	}

	.cmf-ventana-modal-base > div {
		background: #fff;
		width: 680px;
		border-radius: 22px;
		padding: 28px 36px 26px;
		box-shadow: 0 18px 45px rgba(0,0,0,.18);
		position: relative;
	}

	.cmf-ventana-modal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.cmf-ventana-modal-header-1 {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		font-size: 18px;
		color: #5a5bff;
		letter-spacing: .3px;
		text-transform: uppercase;
	}

	.cmf-ventana-modal-header-1 img {
		width: 22px;
	}

	.cmf-ventana-modal-header-2 .cmf-boton {
		background: none;
		border: none;
		cursor: pointer;
	}

	.cmf-ventana-modal-header-2 img {
		width: 28px;
	}

	.cmf-ventana-modal-body {
		margin-top: 24px;
		color: #1f1f1f;
		font-size: 16px;
		line-height: 1.65;
	}

	.cmf-ventana-modal-footer {
		margin-top: 34px;
		display: flex;
		justify-content: flex-end;
		gap: 18px;
	}

	.cmf-boton-common {
		background: #8fa2e6;
		border: none;
		padding: 12px 30px;
		border-radius: 12px;
		font-size: 15px;
		font-weight: 600;
		color: #fff;
		cursor: pointer;
		transition: background .2s ease;
	}

	.cmf-boton-common:hover {
		background: #758ae0;
	}

	.cmf-boton.lock {
		background: none;
		border: none;
		cursor: pointer;
		position: relative;
		width: 32px;
		height: 32px;
	}

	.cmf-boton.lock img {
		position: absolute;
		inset: 0;
		width: 28px;
		transition: opacity .15s ease;
	}

	.cmf-boton.lock .icon-gris {
		opacity: 0;
	}

	.cmf-boton.lock:hover .icon-azul {
		opacity: 0;
	}

	.cmf-boton.lock:hover .icon-gris {
		opacity: 1;
	}

	.cmf-btn-aceptar {
		background-color: #433D9B;
		transition: background-color .2s ease, transform .1s ease;
	}

	.cmf-btn-aceptar:hover {
		background-color: #9aa0a6;
		transform: translateY(-1px);
	}

	.cmf-btn-aceptar:active {
		transform: translateY(0);
	}

	#cmf-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,.75);
		opacity: 0;
		pointer-events: none;
		transition: opacity .2s ease;
		z-index: 9998;
	}

	#cmf-overlay.activo {
		opacity: 1;
		pointer-events: all;
	}
</style>

<div id="cmf-overlay"></div>
<div id="cmf-modal-mensaje" class="cmf-ventana-modal-base">
    <div>
		<div class="cmf-ventana-modal-header">
			<div class="cmf-ventana-modal-header-1">
				<img src="https://kitdigital.cmfchile.cl/assets/icons/info-azul.svg">
				<span>Mensaje Dupol S.A. Corredores de Bolsa</span>
			</div>
			<div class="cmf-ventana-modal-header-2">
				<button type="button"
						class="cmf-boton lock"
						onclick="event.preventDefault(); event.stopImmediatePropagation(); cerrarModalCMF(); return false;">
					<img class="icon-azul" src="https://kitdigital.cmfchile.cl/assets/icons/salir-azul.svg">
					<img class="icon-gris" src="https://kitdigital.cmfchile.cl/assets/icons/salir-gris.svg">
				</button>
			</div>
		</div>

		<div class="cmf-ventana-modal-body">
			Dupol S.A. Corredores de Bolsa se encuentra en proceso de cancelación voluntaria del Registro de Corredores de Bolsa y Agentes de Valores que lleva esta Comisión.
		</div>

		<div class="cmf-ventana-modal-footer">
			<button type="submit"
					class="cmf-boton cmf-boton-common cmf-btn-aceptar"
					onclick="event.preventDefault(); event.stopImmediatePropagation(); cerrarModalCMF(); return false;">
			Aceptar
			</button>
		</div>
    </div>
</div>
