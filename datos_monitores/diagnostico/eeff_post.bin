<script>
	document.addEventListener("DOMContentLoaded", function() {
		let btn_subir = document.querySelector('.ntg-btn-subir');
		if(btn_subir){
  			window.addEventListener("scroll", function() {
    			if (window.scrollY > 200) {
      				btn_subir.classList.add('affix');
    			} else {
      				btn_subir.classList.remove('affix');
    			}
  			});
  			btn_subir.addEventListener("click", function(event) {
    			event.preventDefault();
    			window.scrollTo({ top: 0, behavior: 'smooth' });
  			});
  		}
	});
</script><!--end-box--><!--end-box--><!--end-box--><!--begin-box-container:W4_ar_subtemplates_CCC::8862:Contiene la caja contenedora de los templates para este molde.--><!--loc('Caja contenedora HTML5')--><!--cont=W4_ar_subtemplates_CCC pos=1--><!--begin-box-container:W4_ar_SubTemplates_CC::7912:Contiene los subtemplates que se usan en portadillas.--><!--loc('Caja contenedora HTML5')--><!--cont=W4_ar_SubTemplates_CC pos=1--><!--begin-box:W4_stmp_eidox_body_completo::7665:Template para mostrar el cuerpo completo de eidox.--><!--loc('* Template reutilizable')--><!--end-box--><!--cont=W4_ar_SubTemplates_CC pos=2--><!--begin-box:W4_stmp_pdf_incrustado::8259:Template para mostrar un pdf incrustado en el molde de eidox.--><!--loc('* Template reutilizable')--><!--end-box--><!--cont=W4_ar_SubTemplates_CC pos=3--><!--begin-box:W4_stmp_eidox_seccion_completa::8574:Template para mostrar una sección del eidox.--><!--loc('* Template reutilizable')--><!--end-box--><!--cont=W4_ar_SubTemplates_CC pos=4--><!--begin-box:W4_stmp_eidox_insert_document::8643:Template para mostrar el cuerpo completo de eidox.--><!--loc('* Template reutilizable')--><!--end-box--><!--cont=W4_ar_SubTemplates_CC pos=5--><!--begin-box:W4_stmp_recuadros_enlace_externo::8699:Template para los recuadros que permiten descargar archivos desde links externos al sitio.--><!--loc('* Template reutilizable')--><!--end-box--><!--cont=W4_ar_SubTemplates_CC pos=6--><!--begin-box:W4_stmp_recuadros_fecha_destacada::8537:Contiene el subtemplate para los recuadros con fecha destacada.--><!--loc('* Template reutilizable')--><!--end-box--><!--cont=W4_ar_SubTemplates_CC pos=7--><!--begin-box:W4_stmp_recuadros_documentos_descargar::7631:Template para los recuadros que permiten descargar archivos o recursos del eidox.--><!--loc('* Template reutilizable')--><!--end-box--><!--end-box--><!--end-box--></body><!--
