         AND B.IFRS_PERIODO = C.IFRS_PERIODO
         AND B.IFRS_TIPO_BALANCE = C.IFRS_TIPO_BALANCE
         AND B.ifrs_rut=90749000
		 AND B.IFRS_TIPO_BALANCE='C'
         AND B.IFRS_NOMBRE_CONTEXTO = C.NOMBRE
         and (
		 (ELEMENTO_DIM= 'ifrs-full:SharePremiumMember' and 'ifrs-full:SharePremiumMember'<>'ifrs-full:EquityMember')
		 OR
		 (ELEMENTO_DIM IS NULL AND 'ifrs-full:SharePremiumMember'='ifrs-full:EquityMember')
		 )
         AND B.ifrs_periodo = 202606
         and ifrs_cuenta='cl-ci:IncreaseDecreaseThroughCorrectionsOfErrors'       
		 AND (contexto_desde IS NULL or contexto_desde ='2025-01-01') and contexto_hasta = '2025-12-31'
          -->

	
