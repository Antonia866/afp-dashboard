<script type="text/JavaScript">
<!-- 

  function mostrarFilas(Fila)
  {
	  if(navigator.appName.indexOf("Microsoft") > -1){
		  var visible = 'block'
	  }
	  else {
		  var visible = 'table-row';
	  }
	  Fila.style.display = visible;
  }

  function ocultarFilas(Fila) 
  {
	  Fila.style.display = "none";
  }

  function mostrarTipoNorma()
  {
	  var f  = document;
	  var opt = f.getElementById('fila_tipo');
	  var anno = f.getElementById('aa').options[f.getElementById('aa').options.selectedIndex].value;
	  var mes  = f.getElementById('mm').options[f.getElementById('mm').options.selectedIndex].value;
	  var forma = f.getElementById('forma').value;

	  if (isNaN(anno)) {
		  ocultarFilas(opt);
		  return false;
	  }

	  

	  var f_inf  = parseInt(anno)*100 + parseInt(mes);
	  var f_ini  = parseInt(200912);

	  if (f_inf >= f_ini && (forma=='P' || forma=='F')) {
		  mostrarFilas(opt);
	  }
	  else {
		  ocultarFilas(opt);
	  }

  }
	
	function validarSiNumero(numero)
	{
		if ( (!/^([0-9])*$/.test(numero)) || document.fm.aa.value.length < 4  
		|| document.fm.aa.value < 1000 )
		{
			return false;
		}
		else
		{
			return true;
		}
	}
		
	function validar()
	{
    	var f=document.fm;
     	if (f.aa.value=="###") 
		{
        	alert('Debe seleccionar año');
        	return false;
    	} 
     	if (f.mm.value=="###") 
		{
        	alert('Debe seleccionar mes');
        	return false;
    	}
     	if (f.tipo.value=="###") 
		{
        	alert('Debe seleccionar tipo de balance');
        	return false;
    	} 

		if ( !validarSiNumero(f.aa.value) )
		{
			alert('El valor de Año es Incorrecto');
			document.fm.aa.focus();
		    return false;
		}
		 		         	
		return true;
	}
	function ventana(URL)
	{
    	window.open(URL,'_blank','Height=550,Width=750,menubar,resizable,scrollbars');
	}
	function cargando(){
	    $('#modalCargando').dialog('open');
	}

//-->
</script>
